{
  "name": "rfp-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "build:backend": "cd backend && npm install && npx prisma generate",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "cp -r backend api/backend_src && npx prisma generate --schema=api/backend_src/prisma/schema.prisma && npm run build --workspace=frontend"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-string": "^4.1.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "groq-sdk": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "multer": "^2.1.1",
    "openai": "^6.29.0",
    "pdf-parse": "^2.4.5",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": "20.x"
  }
}
